# 1. Supabase PostgreSQL Connection
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# 2. NextAuth v5 (Auth.js)
# Generate with: npx auth secret
AUTH_SECRET="your-generated-32-byte-base64-secret"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# 3. CyberNexus Club Administration
ADMIN_EMAIL="admin@cybernexus.dz"

# 4. Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. Supabase Storage (Event Poster Uploads)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-secret-key"